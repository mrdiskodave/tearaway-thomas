delete_ks
	; IN	d0=name to del

	movem.l	d0-a6,-(a7)
	bsr	find_ks
	beq	done_dks

	lea	-8(a0),a1
	move.l	-4(a0),d1
	add.l	d1,a0
	addq.l	#8,d1
	move.l	ks_ptr,d0
	add.l	ks_used,d0
	sub.l	a0,d0
	sub.l	d1,ks_used
	bsr	CPUcopy
done_dks
	movem.l	(a7)+,d0-a6
	rts

