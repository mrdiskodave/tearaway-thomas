**** DISK COMMANDS ****

get_lock
	; a0=directory to lock to
	tst.l	locksav
	bne	ERfile
	move.l	a0,d1
	moveq	#-2,d2
	move.l	dosbase,a6
	jsr	Lock(a6)
	move.l	d0,locksav
	beq	ERfile

	; examine it too
	move.l	locksav,d1
	move.l	#page_buff,d2
	move.l	dosbase,a6
	jsr	Examine(a6)
	tst.l	d0
	beq	ERfile
	tst.l	page_buff+4		make sure its a directory
	bmi	ERfile
	rts


drop_lock
	; doesn't complain if there is not one
	move.l	locksav,d1
	beq	anRTS
	move.l	dosbase,a6
	jsr	UnLock(a6)
	clr.l	locksav
	rts

examine_next
	; takes standard lock and examines it's next entry
	; OUT	d0=okay
	move.l	locksav,d1
	move.l	#page_buff,d2
	move.l	dosbase,a6
	jsr	ExNext(a6)
	tst.l	d0
	rts

examine_done
	move.l	dosbase,a6
	jsr	IoErr(a6)
	tst.l	d0
	beq.s	no_dir_hass
	cmp.l	#232,d0
	bne	ERfile
no_dir_hass
	bra	drop_lock

