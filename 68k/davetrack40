**** NEW KS ****

new_ks	; IN	d0=key
	;	d1=bytes needed
	; OUT	d0=okay	(now goes to ERmem)
	; uses	d1/d2

	bsr	delete_ks

	moveq	#1,d2
	and.w	d1,d2
	add.w	d2,d1

	move.l	ks_used,d2
	addq.l	#8,d2
	add.l	d1,d2
	cmp.l	ks_size,d2
	bhi	ERmem

	movem.l	d0-d7/a1-a6,-(a7)

	move.l	ks_ptr,a0
	add.l	ks_used,a0
	move.l	d0,-4(a0)
	move.l	d1,(a0)+

	move.l	a0,-(a7)
	lea	4(a0,d1.w),a1
clrks	clr.w	(a0)+
	cmp.l	a0,a1
	bne.s	clrks

	move.l	d2,ks_used
	move.l	(a7)+,a0
	movem.l	(a7)+,d0-d7/a1-a6
	bra	okay

