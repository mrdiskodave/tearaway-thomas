**** FX3 = WIGGLE ****

FXwiggle
	mulu	#12,d1
	lea	pseudo_chords,a0
	add.l	d1,a0

	move.l	(a0)+,CCwiggle(a2)
	move.l	(a0)+,CCwiggle+4(a2)
	move.l	(a0),CCwiggle+8(a2)
	bra	doneFX

