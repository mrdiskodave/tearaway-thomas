**** KEY ==> TRACKER BYTES ****

find_note
	; IN	d0=note key
	;	d1=note number
	;	d0=okay?

	lea	piano_keys,a0

	moveq	#0,d1
	cmp.w	#Kdel,d0
	beq	okay

	moveq	#1,d1
	cmp.w	#Xctrl+'s',d0
	beq	okay

	moveq	#2,d1
	cmp.w	#Xctrl+'r',d0
	beq	okay

fnloop	move.b	(a0)+,d1
	move.b	(a0)+,d2
	beq	cant
	cmp.b	d0,d2
	bne.s	fnloop
	move.w	octave,d2
	mulu	#clicksize,d2
	add.w	d2,d1
	cmp.w	#num_note,d1
	bcc	cant
	addq.w	#3,d1
	bra	okay

ans0	moveq	#0,d1
	bra	okay

find_hexit
	cmp.w	#Kdel,d0
	beq.s	ans0
	bsr	upcase
	moveq	#16-1,d7
	bra.s	hexit_search

find_instr
	; IN	d0=instrument character
	; OUT	d1=instrument number
	;	d0=okay?
	moveq	#num_instr-1,d7
hexit_search
	lea	hexits,a0
	moveq	#-1,d1
fi	addq.w	#1,d1
	cmp.b	(a0)+,d0
	dbeq	d7,fi
	bne	cant
	bra	okay

