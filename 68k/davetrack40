	; IN	d0=ks to find

	move.l	ks_ptr,a0
	bra.s	fk2
fk1	add.l	(a0)+,a0
fk2	move.l	(a0)+,d1
	beq.s	fkcant
	cmp.l	d1,d0
	bne.s	fk1
	addq.l	#4,a0
	moveq	#-1,d0
	rts
fkcant	moveq	#0,d0
	rts

