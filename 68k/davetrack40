***** RANGED BLOCK OPERATIONS ****

get_range
	; OUT	d2,d3=logical top left of range
	;	d4,d5=logical size of range
	;	d0=okay?
	movem.w	mark_x,d4/d5
	cmp.w	#$7fff,d5
	beq	cant
	movem.w	x_pos,d2/d3
	divu	#4,d2

	cmp.w	d4,d2
	bls.s	big_d4
	exg	d2,d4
big_d4
	cmp.w	d5,d3
	bls.s	big_d5
	exg	d5,d3
big_d5
	sub.w	d2,d4
	sub.w	d3,d5
	bra	okay


BS_none	move.w	#$7fff,mark_y
	rts

BS_one	bsr	far_down
	bsr	make_mark
	bra	far_up

BS_all	bsr	far_down
	bsr	far_right
	bsr	make_mark
	bsr	far_up
	bra	far_left


BO_cut	bsr	get_range
	beq	anRTS
	movem.w	d4/d5,cut_xs
	bsr	range_function
	move.b	(a0),(a3)+
	move.b	1(a0),(a3)+
	move.b	2(a0),(a3)+
	rts

BO_paste
	movem.w	x_pos,d2/d3
	divu	#4,d2
	add.w	cut_xs,d2
	add.w	cut_ys,d3
	cmp.w	#4,d2
	bcc	ERpaste
	cmp.w	y_max,d3
	bhi	ERpaste
	move.l	mark_x,-(a7)
	movem.w	d2/d3,mark_x
	bsr.s	BO_pastecall
	move.l	(a7)+,mark_x
	rts

BO_pastecall
	bsr	range_function
	move.b	(a3)+,(a0)
	move.b	(a3)+,1(a0)
	move.b	(a3)+,2(a0)
	rts

BO_fill	bsr	range_function
	move.b	(a2),(a0)
	move.b	1(a2),1(a0)
	move.b	2(a2),2(a0)
	rts

BO_clr	bsr	range_function
	clr.b	(a0)
	clr.b	1(a0)
	clr.b	2(a0)
	rts

BO_trandown
	bsr	range_function
	cmp.b	#4,(a0)		0=empty 1=stop 2=rel 3=1st note
	bcs	anRTS
	subq.b	#1,(a0)
	rts

BO_tranup
	bsr	range_function
	cmp.b	#3,(a0)
	bcs	anRTS
	cmp.b	#num_note+2,(a0)
	beq	anRTS
	addq.b	#1,(a0)	
	rts

