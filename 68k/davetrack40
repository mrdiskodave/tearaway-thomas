FXdouble
	move.w	clickfresh,d0
	addq.w	#1,d0
	lsr.w	#1,d0
	move.b	d0,CCdouble(a2)
	bra	doneFX

doneFX	moveq	#0,d0
	move.b	CCbyte1(a2),d0
	beq	anRTS
	subq.w	#1,d0
	beq	stopchan
	subq.w	#1,d0
	beq	rellchan

	; !! note stuff !!
	move.w	d0,CCnote(a2)
	lea	tones,a0
	add.w	d0,d0
	move.w	(a0,d0.w),CCperiod(a2)

	; !! instrument stuff !!
	moveq	#0,d0
	move.b	CCbyte2(a2),d0
	movem.l	d0-d7/a1-a6,-(a7)
	bsr	Qinstr_adr
	movem.l	(a7)+,d0-d7/a1-a6
	beq	stopchan		instrument slot vacant!
	move.l	a0,a5

	bsr	chk_instr

	move.l	a5,CCinstr(a2)

	move.l	(a2),a6

	; a2=chan
	; a5=instrument
	; a6=hardware

	tst.w	(a5)
	bne	init_sample

	; init period mod
	move.b	Itone_pause(a5),CCpmcntdown(a2)
	clr.b	CCpmindx(a2)

	; init asdr
	clr.w	CCvol(a2)
	clr.w	CCasdrpc(a2)
	clr.b	CCasdrtime(a2)

	; load wave to hardware
	move.w	CCdmaoff(a2),$dff096
	lea	Iloop(a5),a0
	move.l	a0,ac_ptr(a6)
	moveq	#0,d0
	move.b	Iloop_size(a5),d0
	move.w	d0,ac_len(a6)

	move.w	#8,CCstate(a2)
