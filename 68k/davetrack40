play_chan2
	; IN	a2=chan struct

	cmp.w	#12,CCstate(a2)
	beq	anRTS

	move.b	CCbyte1(a2),d0
	or.b	CCbyte2(a2),d0
	or.b	CCbyte3(a2),d0
	beq	anRTS

	clr.w	CCportspeed(a2)

	moveq	#0,d0
	move.b	CCbyte3(a2),d0		=FX byte
	moveq	#15,d1
	and.w	d0,d1			=FX data
	lsr.w	#4,d0			=FX command
	beq	doneFX
	cmp.w	#5,d0
	bcc	doneFX

	add.w	d0,d0
	lea	FXjmps(pc),a0
	add.w	-2(a0,d0.w),a0
	jmp	(a0)

FXjmps	dc.w	FXport-FXjmps		1
	dc.w	FXasdrspd-FXjmps	2
	dc.w	FXwiggle-FXjmps		3
	dc.w	FXdouble-FXjmps		4


**** FX1 = PORT ****

FXport	addq.w	#1,d1
	move.w	d1,CCportspeed(a2)
	move.b	CCbyte1(a2),d0
	add.w	d0,d0
	lea	tones,a0
	move.w	(a0,d0.w),CCportdest(a2)
	rts

**** FX2 = ASDR ****

FXasdrspd
