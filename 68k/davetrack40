*** TONE CONTROL ***

	move.w	CCportspeed(a2),d2
	beq	check_wiggle

	; PORT IT
	move.w	CCperiod(a2),d0
	move.w	CCportdest(a2),d1

	cmp.w	d0,d1
	beq	got_period
	clr.w	CCasdrpc(a2)

	slide.w	d0,d1,d2
	move.w	d0,CCperiod(a2)
	bra	got_period

check_wiggle
	; WIGGLE IT
	move.w	CCwiggleindx(a2),d1
	move.w	CCnote(a2),d0
	add.b	CCwiggle(a2,d1.w),d0
	add.w	d0,d0
	lea	tones,a0
	move.w	(a0,d0.w),d0
	addq.w	#1,d1
	cmp.w	#12,d1
	bcs.s	nowigrap
	moveq	#0,d1
nowigrap
	move.w	d1,CCwiggleindx(a2)

got_period
	; d0=period
	; BEND IT
	move.b	Itone_speed(a5),d3
	beq	done_permod

	tst.b	CCpmcntdown(a2)
	beq.s	permod
	subq.b	#1,CCpmcntdown(a2)
	bra.s	done_permod
permod
	moveq	#0,d1
	move.b	CCpmindx(a2),d1
	move.b	Itone(a5,d1.w),d2
	ext.w	d2
	moveq	#0,d4
	move.b	Itone_mulu(a5),d4
	muls	d4,d2
	add.w	d2,d0

	sub.b	d3,CCpmindx(a2)
	bcc.s	done_permod

	move.b	Itone_size(a5),d2
	add.b	d2,d2
	add.b	d2,CCpmindx(a2)

done_permod
	move.w	d0,ac_per(a6)

**** VOLUME CONTROL ****

	subq.b	#1,CCasdrtime(a2)
	bcc	skip_asdr
	move.b	CCasdrfresh(a2),CCasdrtime(a2)

	move.w	CCvol(a2),d1
	move.w	CCasdrPC(a2),d0

	move.b	Iasdr(a5,d0.w),d2	dest
	add.b	d2,d2
	add.b	d2,d2
	move.b	Iasdr+1(a5,d0.w),d3	rate

	slide.b	d1,d2,d3

	cmp.b	d1,d2
	bne.s	done_asdr
	subq.w	#6,d0
	beq.s	done_asdr
	addq.w	#8,d0
	move.w	d0,CCasdrPC(a2)
done_asdr
	move.w	d1,CCvol(a2)
	lsr.w	#2,d1
	move.w	d1,ac_vol(a6)
skip_asdr

**** SQUARE MODIFY ****

	move.b	Isqr_rate(a5),d0		not needed!
