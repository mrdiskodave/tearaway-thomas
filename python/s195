	; FUTURELAND NORMAL MODE

future_normal
	bsr	find_kipper
	movem.w	PLx,d2/d3

	tst.b	touch_floor
	beq	FNin_the_air

	; ON THE FLOOR-
	st	touch_floor	on the floor
	sf	jumping	so we can't be jumping

	; TERRAIN FOLLOWING
FNfloor_loop	moveq	#1,d1
	bsr	next_kipper
	move.w	d2,d7
	add.w	d0,d2

headroom=16

	sub.w	#headroom,d3
	bsr	pixel_test
	add.w	#headroom,d3
	tst.w	d0
	bne	FNcantX	hit head

	; vacup or stop
	bsr	pixel_test
	beq.s	FNhigh_happy
	subq.w	#1,d3
	bsr	pixel_test
	beq.s	FNhigh_happy
	addq.w	#1,d3
FNcantX	move.w	d7,d2
	sf	move_stick
	bra	FNxmovedone
FNhigh_happy

	; vac down or drop_off_ground
	addq.w	#1,d3
	bsr	pixel_test
	bne.s	FNnovac
	addq.w	#1,d3
	bsr	pixel_test
	beq.s	FNdrop_off_ground
FNnovac
	subq.w	#1,d3
FNvacdone
	tst.w	kipper
	bne.s	FNfloor_loop

FNxmovedone
	; JUMP OFF GROUND?
	btst	#4,joy_byte
	beq	moved_player	<<<<
	bsr	player_jump
	bra	FNin_the_air

	; IN THE SKY-
FNdrop_off_ground
	clr.w	PLvely
	sf	jumping
	move.b	#4,jump_chance

FNin_the_air	sf	touch_floor

	; JUMP OFF SKY?
	tst.b	jump_chance
	beq.s	FNnot_a_chance
	subq.b	#1,jump_chance
	btst	#4,joy_byte
	beq.s	FNnot_a_chance
	bsr	player_jump
FNnot_a_chance

FNflyx_loop	moveq	#1,d1
	bsr	next_kipper
	move.w	d2,d7
	add.w	d0,d2

	sub.w	#headroom,d3
	bsr	pixel_test
	add.w	#headroom,d3
	tst.w	d0
	bne	FNabortflyx

	bsr	pixel_test
	beq.s	FNhigh_happy2
	subq.w	#1,d3
	bsr	pixel_test
	bne.s	FNdontland
	st	touch_floor
	bra.s	FNdone_flyX

FNdontland	addq.w	#1,d3
FNabortflyx	move.w	d7,d2
	bra	FNdone_flyX

FNhigh_happy2	tst.w	kipper
	bne.s	FNflyx_loop


FNdone_flyX

	bsr	gravity
	tst.w	PLvely
	beq	FNdoneymove
	bpl	FNgoing_down

FNgoing_up	move.w	PLvely,d7
	neg.w	d7
	subq.w	#1,d7
FNup_loop
	tst.b	touch_floor
	bne.s	FNdoneymove
	subq.w	#1,d3
	bsr	landing_lights
	sub.w	#headroom,d3
	bsr	pixel_test
	add.w	#headroom,d3
	tst.w	d0
	bne.s	FNhithead
	dbf	d7,FNup_loop
	bra	FNdoneymove


FNhithead	move.w	PLvely,d0
	cmp.w	#-jmpv+1,d0
	bgt.s	nohhstun
	bsr	sure_stun
nohhstun	neg.w	d0
	asr.w	#2,d0
	move.w	d0,PLvely
	bra	FNdoneymove

FNgoing_down	move.w	PLvely,d7
	subq.w	#1,d7

FNdown_loop	tst.b	touch_floor
	bne.s	FNdoneymove
	addq.w	#1,d3
	bsr	landing_lights
	dbf	d7,FNdown_loop
FNdoneymove
	bra	moved_player

