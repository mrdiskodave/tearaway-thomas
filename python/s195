	; WALK MODE...
	PROC
walk_mode
	; START MUDDY SLIDE?
	tst.b	touch_floor
	beq	nofloormode
	bsr	Qmuddy
	bne	mud_mode_on

	; MAGIC FX?
	movem.w	PLx,d2/d3
	addq.w	#6,d3
	bsr	Qmapadr
	move.w	(a1),d4
	lea	PLmblks,a0
	rept	5
	cmp.w	(a0)+,d4
	beq.s	gotmagic
	endr
	cmp.w	(a0),d4
	bne.s	notmagic
gotmagic
	move.w	game_clock,d0
	sub.w	PLmagiclock,d0
	cmp.w	#4,d0
	bcs.s	notmagic
	move.w	game_clock,PLmagiclock
	bsr	create_object
	move.b	#24,OBtype(a3)
	movem.w	PLx,d2/d3
	bsr	real_random
	and.w	#15,d0
	sub.w	#8,d0
	add.w	d0,d2
	movem.w	d2/d3,OBx(a3)
	bset	#OBFstayout,OBflags(a3)
notmagic

nofloormode
	; START ROPE MODE?

	move.b	#%0101,d0
	and.b	d1,d0
	beq.s	cant_rope

	movem.w	PLx,d2/d3
	bsr	test_rope
	beq.s	cant_rope
	tst.b	PLropelatch
	beq	start_rope_mode
	bra.s	LLrope
cant_rope
	sf	PLropelatch
LLrope
	; START PIPE MODE?

	tst.w	PLstun
	bne.s	cant_pipe
	cmp.w	#9,PLmode
	beq.s	cant_pipe
	tst.b	PLpipestart
	beq.s	wont_pipe
	tst.b	PLpipelatch
	bne.s	cant_pipe
	bra	start_pipe_mode
wont_pipe	sf	PLpipelatch
cant_pipe

	; START FLYING?
	tst.b	PLflyable
	beq.s	cant_fly
	tst.b	touch_floor
	bne.s	cant_fly
	tst.b	jump_chance
	bne.s	cant_fly
	lea	joy_byteAA,a0
	btst	#4,(a0)
	beq	cant_fly
	st	PLflying
	st	PLlastanim
	clr.w	PLvely
	clr.w	PLvelyfrac
cant_fly
	; START MONKEY? SCC5

	tst.b	touch_floor
	bne.s	cant_monkey

	movem.w	PLx,d2/d3
	sub.w	#monkY,d3
	bsr	Qmapadr
	move.w	(a1),d0
	cmp.w	PLropeblock,d0
	bne	cant_monkey
	tst.w	PLstun
	bne.s	cant_monkey

	tst.w	PLvely
	bmi.s	shallnt_monkey
	btst	#0,d1
	bne.s	shallnt_monkey
	tst.b	PLmonkeylatch
	beq	start_monkey_mode
	bra.s	shallnt_monkey
cant_monkey
	sf	PLmonkeylatch
shallnt_monkey


	
	; START LADDER?
	;  4f 3l 2u 1r 0d
	move.b	#%0101,d0			SCC9
	and.b	d1,d0
	beq	cant_ladder

	movem.w	PLx,d2/d3
	add.w	PLladtop,d3
	bsr	LM_testladder
	beq	cant_ladder
	sub.w	PLladtop,d3
	add.w	PLladbot,d3
	bsr	LM_testladder
	beq	cant_ladder

	tst.b	PLlatch
	beq	start_ladder_mode
	tst.b	touch_floor
	beq	normal_mode
	sf	PLlatch
	bra	start_ladder_mode

